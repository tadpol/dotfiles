#!/bin/zsh
# Check all of the various things for updates
# And pretty some of them
set -euo pipefail

if (whence brew >/dev/null); then
  function check_brew() {
    brew update -q
    brew outdated --greedy
  }
  function upgrade_brew() {
    brew upgrade --greedy -y
  }
fi

if (whence mise >/dev/null); then
  function check_mise() {
    mise outdated --bump
  }
  function upgrade_mise() {
    mise upgrade
  }
fi

if (whence mas >/dev/null); then
  function check_mas() {
    mas outdated | mlr --hi --opprint \
      put '$1 =~ "(\d+)\s(.*)\s\((\d+(?:\.\d+)*) -> (\d+(?:\.\d+)*)\)"; $1="\1"; $2="\2"; $3="\3"; $4="\4"' \
      then label id,name,installed,newest \
      then sort -f name
  }
  function upgrade_mas() {
    sudo mas upgrade
  }
fi

if (whence apt >/dev/null); then
  function check_apt() {
    sudo apt update -qq
    sudo apt list --upgradeable
  }
  function upgrade_apt() {
    sudo apt upgrade -y
  }
fi

local action=check
while [[ $# > 0 && "$1" == -* ]]; do
  case "$1" in
  -u | --up | --upgrade)
    action=upgrade
    ;;
  *)
    echo "Unknown option: $1"
    exit 1
    ;;
  esac
  shift
done

if [[ $# > 0 ]]; then
  ${action}_${1}
else
  for fn in ${(@ok)functions[(I)${action}_*]}; do
    echo "⁌ $fn ⁍"
    $fn
  done
fi

#  vim: set ft=zsh sw=2 ts=2 :
