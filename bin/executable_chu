#!/bin/zsh
# Check all of the various things for updates
# And pretty some of them
autoload -Uz zargs

if (whence brew >/dev/null); then
function check_brew() {
  brew update -q
  brew outdated --greedy
}
fi

if (whence mise >/dev/null); then
function check_mise() {
  mise outdated --bump
}
fi

if (whence mas >/dev/null); then
function check_mas() {
  mas outdated | mlr --hi --opprint \
    put '$1 =~ "(\d+)\s(.*)\s\((\d+(?:\.\d+)*) -> (\d+(?:\.\d+)*)\)"; $1="\1"; $2="\2"; $3="\3"; $4="\4"' \
    then label id,name,installed,newest \
    then sort -f name
}
fi


if (whence pipx >/dev/null); then
function check_pipx() {
  local installed=$(pipx list --json)

  function _get_latest() {
    local pkg=$1
    local latest=$(pip index versions $pkg --json | jq -r .latest)
    echo "$pkg,$latest"
  }

  local pkgs=($(jq -r '.venvs | to_entries[].key' <<<$installed))
  [[ $#pkgs -eq 0 ]] && return
  local latest=$(echo "name,newest"; zargs -P 5 -l 1 -- $pkgs -- _get_latest)

  jq -r '.venvs | to_entries[] | .value |= .metadata.main_package.package_version' <<<$installed \
  | mlr --ijson --opprint label name,installed \
      then join --icsv -j name -f =(<<<$latest) \
      then filter '$installed != $newest' \
      then reorder -f name,installed,newest \
      then sort -f name
}
fi

if (whence asdf >/dev/null); then
function check_asdf() {
  # Many plugins (fe: Ruby and Python) have multiple build streams and asdf squashes them all into
  # a single version list.  This makes `asdf latest …` not very useful
  #
  # Not a great solution, but the egrep works for my usage.

  plugins=($(asdf plugin list))
  for p in $plugins; do
    local installed=($(asdf list $p | sed -e 's/\*/ /'))
    local latest=$(asdf list all $p | egrep '^[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$' | tail -1)

    # Check to see if lastest version installed. It might not be current.
    local found=1
    for x in "${installed[@]}"; do
      if [[ $x == $latest ]]; then
        found=0; break
      fi
    done
    if (( found )); then
      local current=$(asdf current $p | tail -1 | awk '{print $2}')
      #latest=$(asdf latest $p)
      local inst=$(print -rl -- "${installed[@]}" | sort -V | tail -1)
      echo "$p\t$inst\t$current\t$latest"
    fi
  done | mlr --hi --itsv --opprint label language,installed,current,newest
}
fi

if (whence apt >/dev/null); then
function check_apt() {
  sudo apt update -qq
  sudo apt list --upgradeable
}
fi

if [[ $# > 0 ]]; then
  check_$1
else
  for fn in ${(@ok)functions[(I)check_*]}; do
    echo "⁌ $fn ⁍"
    $fn
  done
fi

#  vim: set ft=zsh sw=2 ts=2 :
