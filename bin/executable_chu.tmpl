#!/bin/zsh
# Check all of the various things for updates
# And pretty some of them

{{ if eq .chezmoi.os "darwin" -}}
function check_brew() {
  brew update -q
  brew outdated --greedy
}

function check_mas() {
  mas outdated | mlr --hi --opprint \
    put '$1 =~ "(\d+)\s(.*)\s\((\d+(?:\.\d+)*) -> (\d+(?:\.\d+)*)\)"; $1="\1"; $2="\2"; $3="\3"; $4="\4"' \
    then label id,name,installed,newest \
    then sort -f name
}
{{- end}}
{{ if eq .chezmoi.os "linux" -}}
function check_apt() {
  sudo apt update
  sudo apt list --upgradable
}
{{- end}}


function check_asdf() {
  # Many plugins (fe: Ruby and Python) have multple build streams and asdf squashes them all into
  # a single version list.  This makes `asdf latest …` not very useful
  #
  # Not a great solution, but the egrep works for my usage.

  plugins=($(asdf plugin list))
  for p in $plugins; do
    current=$(asdf current $p | tail -1 | awk '{print $2}')
    #latest=$(asdf latest $p)
    latest=$(asdf list all $p | egrep '^[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$' | tail -1)
    if [[ "$current" != "$latest" ]]; then
      echo "$p\t$current\t$latest"
    fi
  done | mlr --hi --itsv --opprint label language,installed,newest
}

if [[ $# > 0 ]]; then
  check_$1
else
  for fn in ${(@ok)functions[(I)check_*]}; do
    $fn
  done
fi

