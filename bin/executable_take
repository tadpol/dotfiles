#!/usr/bin/env zsh
# A bag to carry files around as you go from directory to directory
#
# This should be linked to the following names: inv, take, drop

##############################################################################
argv0=${${0:t}:r}

# Check that argv0 is one of the expected commands
if [[ "$argv0" != "inv" && "$argv0" != "take" && "$argv0" != "drop" ]]; then
  echo "Usage: $argv0 [options] <args>" >&2
  echo "Available commands: inv, take, drop" >&2
  exit 1
fi

# Separate options and arguments out of the cmdline
typeset -A Options
Args=()
for opt in "$@"; do
  case $opt in
    --h|--help) Options[help]=1 ;;
    --append|-a|--add) Options[add]=1 ;;
    --move|-m) Options[move]=1 ;;
    --select|-s) Options[select]=1 ;;
    --verbose|-v) Options[verbose]=1 ;;
    *) Args+=("$opt") ;;
  esac
done

##############################################################################
# Some helpers
function _get_bag {
  local bag="$HOME/.local/state/inv/files"
  mkdir -p ${bag:h}
  echo $bag
}

##############################################################################

# Since we have three top level commands that don't have sub commands, we implement them
# all as the 'task not found' handler. This is a bit of a hack, but it works.
function inv_help {
  echo "inv - show the contents of the bag"
}
function inv {
  local bag=$(_get_bag)
  [[ -f "$bag" ]] && cat $bag
}

function take_help {
  echo "take - add files or directories to the bag"
  echo "Usage: take [options] <file1> <file2> ..."
  echo "Options:"
  echo "  --append, -a    Append to the existing bag instead of replacing it"
  echo "  --add           Same as --append"
}
function take {
  # Write to the bag file, each arg on one line.
  # Replacing old bag unless --append or --add is given
  local bag=$(_get_bag)
  if [[ -z "${Options[add]}" ]]; then
    rm -f $bag
  fi
  for arg in $*; do
    # Get the absolute path
    [[ -e "$arg" ]] && realpath "$arg" >> $bag
  done
}

function drop_help {
  echo "drop - copy or move files from the bag to the current directory or a specified directory"
  echo "Usage: drop [options] [destination]"
  echo "Options:"
  echo "  --move, -m      Move files instead of copying them"
  echo "  --select, -s    Use fzf to select files to drop"
  echo "If no destination is given, the current directory is used"
}
function drop {
  local dest=${1:-$PWD}
  [[ ! -d "$dest" ]] && echo "Error: $dest is not a directory" >&2 && return
  local bag=$(_get_bag)
  [[ ! -f "$bag" ]] && return
  local to_drop
  # if --select is given, use the fzf to select files to drop
  if [[ -n "${Options[select]}" ]]; then
    cat $bag | fzf -m --prompt="Select files to drop> " | IFS=$'\n' read -d '' -r -A to_drop
    if [[ ${#to_drop[@]} -eq 0 ]]; then
      echo "No files selected to drop"
      return
    fi
  else
    IFS=$'\n' read -d '' -r -A to_drop < $bag
  fi
  # if --move, move to the given directory otherwise copy
  # don't update the bag until after all files are copied/moved
  for file in $to_drop; do
    if [[ ! -e "$file" ]]; then
      [[ -n "$Options[verbose]" ]] && echo "Warning: $file does not exist, skipping"
      continue
    fi
    if [[ -n "$Options[move]" ]]; then
      mv "$file" "$dest"
    else
      cp -r "$file" "$dest"
    fi
  done
}

##############################################################################

[[ -n "${Options[help]}" ]] && "${argv0}_help" && exit 0
${argv0} "${Args[@]}"
