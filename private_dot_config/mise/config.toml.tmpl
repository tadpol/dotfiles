[tools]
bun = "latest"
{{- if .amHostOs }}
dive = "latest"
go = "latest"
herdr = "latest"
mitmproxy = "latest"
node = "latest"
"npm:npm-check-updates" = "latest"
ollama = "latest"
"pipx:marimo" = "latest"
pitchfork = "latest"
python = "latest"
{{- else if .agentVm }}
oh-my-pi = {
  version = "latest",
  postinstall = "omp install github:DietrichGebert/ponytail",
  rename_exe = "omp"
}
uv = "latest"
{{- end }}
"pipx:llm" = { version = "latest", postinstall = "llm install llm-ollama && llm install llm-anthropic" }
usage = "latest"

[settings]
color_theme = "base16"
{{- if .amHostOs }}
minimum_release_age = "3d"
{{- end }}
tool_update.global_auto = false

[env]
{{- if .agentVm }}
PI_PROXY_GLASSDEV = "http://host.lima.internal:8888"
{{- end }}

