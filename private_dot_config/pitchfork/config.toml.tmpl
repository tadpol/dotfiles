[settings.proxy]
enable = true
port = 27000
https = false

[settings.logs]
line_retention = 5000

{{ if .amHostOs }}
[daemons.ollama]
run = "ollama serve"
mise = true
boot_start = true
ready_http = "http://localhost:11434/"

[daemons.ollama.env]
OLLAMA_FLASH_ATTENTION = "1"
OLLAMA_KV_CACHE_TYPE = "q8_0"
{{ end -}}
